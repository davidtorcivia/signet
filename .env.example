# Copy to .env and fill in. .env is gitignored and must never be committed.

# The bearer token the Pebble app sends. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# In the app, the Authorization header value is used verbatim, so what you type there is
# "Bearer <this value>" — including the word Bearer. signet rejects a bare token by design.
# This token cannot be rotated from the phone, so treat it like a password: one per client,
# long, and revocable here.
SIGNET_TOKEN=

# Where journal.jsonl (P0) and later signet.db (P1) live. Inside the container this is /data,
# bind-mounted from ./data.
SIGNET_DATA_DIR=/data

# Listen address inside the container. Leave as-is; Caddy fronts it.
SIGNET_HOST=0.0.0.0
SIGNET_PORT=8300

# --- Later phases ---
# P2 fallback only. Results are delivered in band wherever possible, because an MCP result is
# what renders natively in the app and on the watch. ntfy is for work too slow to answer inline.
# NTFY_URL=http://ntfy:2586
# P2: GOOGLE_CLIENT_ID=
# P2: GOOGLE_CLIENT_SECRET=
# P2: SIGNET_FERNET_KEY=

# Optional. Without it signet still captures and still searches, which is most of the value,
# so a missing key degrades rather than blocks.
OPENROUTER_API_KEY=
SIGNET_MODEL=deepseek/deepseek-v4-flash-0731

# Runaway-loop breaker, not an economy measure. A heavy day costs a few cents.
SIGNET_DAILY_COST_CAP_USD=2.00

# Set this to enable the admin portal at /app. Without it the portal is not mounted at all,
# because this process is reachable from the internet through the tunnel.
SIGNET_ADMIN_PASSWORD=

# Optional. Web search via Exa (https://exa.ai). Without it, ask answers from your journal
# only. Exa returns page text with results, so one call gets both sources and content.
EXA_API_KEY=

# Guards the bundled open-meteo MCP container, which is not published and is reachable only by
# signet over the compose network. Open-Meteo itself needs no account, so this is the only
# secret weather involves. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Leaving it empty still works — the server then accepts any caller, which on a private network
# is nobody but signet. Set it and register the upstream's auth header as "Bearer <this value>".
OPENMETEO_API_KEY=
